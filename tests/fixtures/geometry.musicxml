<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN"
                                "http://www.musicxml.org/dtds/partwise.dtd">
<!-- Ground truth for the PDF geometry tests. Hand-authored so the expected
     answers are known by construction, and rendered to PDF with MuseScore so the
     fixture is ours to publish.

     Deliberately reproduces every failure mode named in the state of play:
       * three staves per system (voice + piano), so piano and voice stems
         interleave in x and no longer leave the widest gap at a barline
       * wildly uneven bar widths (eight eighths against one whole note)
       * an implicit pickup bar, which equal-width slots cannot model
       * two chord symbols in one bar, on beats 1 and 3
       * a long lyric in the last bar that runs past the final barline
     Expected values live in tests/test_pdf_geometry.py. -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Voice</part-name>
    </score-part>
    <score-part id="P2">
      <part-name>Piano</part-name>
    </score-part>
  </part-list>

